# =============================================================================
# Job Ops - Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

MODEL=google/gemini-3-flash-preview

# LLM provider (optional). Examples: openrouter, requesty, openai, gemini, gemini_cli, claude_cli, codex.
# LLM_PROVIDER=gemini_cli
# For Gemini (CLI): install @google/gemini-cli, run `gemini` and sign in (OAuth), or set
# GEMINI_API_KEY in the environment. Optional overrides:
# GEMINI_CLI_BIN=gemini
# Optional: path to bundle/gemini.js (avoids Windows cmd.exe when using JSON-heavy prompts).
# GEMINI_CLI_SCRIPT=C:\Users\you\AppData\Roaming\npm\node_modules\@google\gemini-cli\bundle\gemini.js
# Windows: if GEMINI_CLI_BIN is …\npm\gemini.cmd, JobOps spawns Node on …\npm\node_modules\@google\gemini-cli\bundle\gemini.js when that file exists (no shell).
# GEMINI_CLI_TRUST_WORKSPACE=true
# GEMINI_CLI_REQUEST_TIMEOUT_MS=120000
# GEMINI_CLI_VALIDATION_TIMEOUT_MS=60000
# For Claude (CLI): install @anthropic-ai/claude-code, run `claude setup-token` (requires a
# Claude Pro/Max/Team/Enterprise subscription) and set the printed token below, or set
# ANTHROPIC_API_KEY in the environment instead. No credential file mount is needed.
# CLAUDE_CODE_OAUTH_TOKEN=
# Optional overrides:
# CLAUDE_CLI_BIN=claude
# CLAUDE_CLI_REQUEST_TIMEOUT_MS=120000
# CLAUDE_CLI_VALIDATION_TIMEOUT_MS=60000
# LLM import timeouts (resume upload during onboarding). Increase for slow local models.
# LLM_IMPORT_OPENAI_TIMEOUT_MS=60000
# LLM_IMPORT_OPENROUTER_TIMEOUT_MS=90000
# LLM_IMPORT_GEMINI_TIMEOUT_MS=90000
# LLM_IMPORT_LOCAL_TIMEOUT_MS=120000
# Ghostwriter capability check timeout.
# LLM_GHOSTWRITER_CAPABILITY_TIMEOUT_MS=2500
# Codex login timeouts.
# CODEX_APP_SERVER_DEVICE_AUTH_TIMEOUT_MS=15000
# CODEX_APP_SERVER_LOGOUT_TIMEOUT_MS=10000

# Optional: Authentication for protected app and API access
# The app is fully unauthenticated if this isn't set, which is the default.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Optional JWT secret for session tokens (at least 32 characters).
# If omitted and authentication is enabled, Job Ops generates and stores one in DATA_DIR.
# JWT_SECRET=
# Optional: JWT token expiry in seconds (default: 86400 = 24 hours).
# JWT_EXPIRY_SECONDS=86400

# Optional hosted single-tenant mode.
# Leave unset for the default local/self-hosted behavior.
# JOBOPS_APP_MODE=hosted
# Required when JOBOPS_APP_MODE=hosted. This must refer to the configured hosted tenant.
# JOBOPS_HOSTED_TENANT_ID=tenant_hosted
# Optional hosted capabilities. Defaults are disabled.
# JOBOPS_HOSTED_SIGNUPS_ENABLED=false
# JOBOPS_HOSTED_PLATFORM_LLM_ENABLED=false
# JOBOPS_HOSTED_QUOTAS_ENABLED=false

# Public base URL used to generate tracer links when PDFs are created by
# background/pipeline runs (where request host cannot be inferred).
# Example: JOBOPS_PUBLIC_BASE_URL=https://jobops.example.com
JOBOPS_PUBLIC_BASE_URL=

# =============================================================================
# Reactive Resume (RxResume) v5
# =============================================================================
# Required for tailored resume generation. Use v5 API keys.
RXRESUME_API_KEY=
# Optional override for self-hosted instances (defaults to https://rxresu.me)
# RXRESUME_URL=https://rxresu.me

# =============================================================================
# Gmail OAuth (Tracking Inbox) - optional
# =============================================================================
# Required to connect Gmail from the UI.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# Optional override for OAuth callback URL.
# If unset, defaults to <request-origin>/oauth/gmail/callback
# GMAIL_OAUTH_REDIRECT_URI=http://localhost:3005/oauth/gmail/callback

# =============================================================================
# UKVisaJobs (UK visa sponsorship jobs) - optional
# =============================================================================
# Provide email/password for automatic login and token refresh.
# See extractors/ukvisajobs/README.md for detailed instructions.
UKVISAJOBS_EMAIL=
UKVISAJOBS_PASSWORD=
UKVISAJOBS_HEADLESS=true

# =============================================================================
# Adzuna (multi-country API source) - optional
# =============================================================================
# App credentials from Adzuna developer account.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional default per-term cap (can be overridden by UI run budget logic).
# ADZUNA_MAX_JOBS_PER_TERM=50

# =============================================================================
# Seek (via Apify) - optional, Australia job board
# =============================================================================
# Apify API token for running the unfenced-group/seek-com-au-scraper actor.
# Free tier provides $5/month credit (~3,000 results). Get your token at:
# https://console.apify.com/account/integrations
APIFY_TOKEN=
# Optional default per-term cap (can be overridden by UI run budget logic).
# SEEK_MAX_JOBS_PER_TERM=50
# Optional: override the Apify actor used for Seek scraping.
# SEEK_APIFY_ACTOR_ID=unfenced-group/seek-com-au-scraper



# =============================================================================
# Public remote API job sources - optional
# =============================================================================
# Himalayas public API page cap for each run (default: 2, max: 10).
# HIMALAYAS_PAGES=2
# USAJOBS Search API credentials. If omitted, the USAJOBS source is skipped
# without failing the discovery run. Use your email or app user-agent string.
# USAJOBS_API_KEY=
# USAJOBS_USER_AGENT=you@example.com

# =============================================================================
# Background discovery and autonomous auto-apply - optional, safe by default
# =============================================================================
# Periodically runs the existing discovery/import pipeline in the background.
# Disabled by default; set true only if you want unattended job discovery.
# JOBOPS_BACKGROUND_DISCOVERY_ENABLED=false
# JOBOPS_BACKGROUND_DISCOVERY_INTERVAL_MS=900000
# JOBOPS_BACKGROUND_DISCOVERY_MIN_INTERVAL_MS=300000
# JOBOPS_BACKGROUND_DISCOVERY_RUN_ON_START=false
# Optional comma-separated source override, e.g. remotive,jobicy,himalayas
# JOBOPS_BACKGROUND_DISCOVERY_SOURCE_OVERRIDES=
# JOBOPS_BACKGROUND_DISCOVERY_TOP_N=10
# JOBOPS_BACKGROUND_DISCOVERY_MIN_SCORE=50

# Queues READY jobs for autonomous review. This is dry-run/human-confirmation by
# default and never submits portals or bypasses CAPTCHA/challenges.
# JOBOPS_AUTONOMOUS_AUTO_APPLY_QUEUE_ENABLED=false
# JOBOPS_AUTONOMOUS_AUTO_APPLY_INTERVAL_MS=600000
# JOBOPS_AUTONOMOUS_AUTO_APPLY_BATCH_LIMIT=10
# JOBOPS_AUTONOMOUS_AUTO_APPLY_RETRY_DELAY_MS=30000
# Optional immediate scan on server startup. Disabled by default.
# JOBOPS_AUTONOMOUS_AUTO_APPLY_RUN_ON_START=false
# Explicit opt-in required before the queue sends real email applications via
# AUTO_APPLY_* SMTP settings. Portal/CAPTCHA jobs remain human-in-loop unless
# JOBOPS_FULL_AUTO_APPLY_ENABLED is enabled below.
# JOBOPS_AUTONOMOUS_EMAIL_APPLY_ENABLED=false
# AUTO_APPLY_SMTP_HOST=
# AUTO_APPLY_SMTP_PORT=587
# AUTO_APPLY_SMTP_SECURE=false
# AUTO_APPLY_SMTP_STARTTLS=1
# AUTO_APPLY_SMTP_USER=
# AUTO_APPLY_SMTP_PASS=
# AUTO_APPLY_EMAIL_FROM=
# AUTO_APPLY_EMAIL_FROM_NAME=

# =============================================================================
# CAPTCHA solving - optional, disabled by default
# =============================================================================
# Requires explicit opt-in. Unified server solver for known extractor challenges only.
# Used by extractor challenges, and by portal/application CAPTCHA only when
# JOBOPS_FULL_AUTO_APPLY_ENABLED and JOBOPS_AUTONOMOUS_CAPTCHA_APPLY_ENABLED are explicitly on.
# CAPTCHA_SOLVER_PROVIDER=manual
# CAPTCHA_SOLVER_AUTO_SOLVE_ENABLED=0
# CAPTCHA_SOLVER_API_KEY=

# =============================================================================
# Full-auto portal application submission - dangerous, disabled by default
# =============================================================================
# Master gate for autonomous browser submissions. Keep false unless you accept
# unattended application submissions, portal form filling, consent checkbox clicks,
# resume upload, submit clicks, and paid CAPTCHA solving where configured.
# JOBOPS_FULL_AUTO_APPLY_ENABLED=false
# JOBOPS_AUTONOMOUS_PORTAL_APPLY_ENABLED=false
# JOBOPS_AUTONOMOUS_CAPTCHA_APPLY_ENABLED=false
# Backward-compatible aliases also recognized:
# JOBOPS_FULL_AUTO_ENABLED=false
# JOBOPS_FULL_AUTO_BROWSER_SUBMIT_ENABLED=false
# JOBOPS_FULL_AUTO_CAPTCHA_ENABLED=false
# JOBOPS_FULL_AUTO_BROWSER_HEADLESS=true
# JOBOPS_FULL_AUTO_BROWSER_TIMEOUT_MS=120000
# JOBOPS_FULL_AUTO_CAPTCHA_TIMEOUT_MS=180000


# =============================================================================
# JobSpy - Job search configuration
# =============================================================================
# Filter for remote-only jobs (default: 0 = disabled)
# JOBSPY_IS_REMOTE=0
